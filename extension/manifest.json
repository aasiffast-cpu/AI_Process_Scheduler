{
  "manifest_version": 3,
  "name": "AI Process Scheduler",
  "version": "1.0.0",
  "description": "Smart AI-driven OS Process & Task Scheduler with Gantt charts, live simulation, and algorithm comparison.",
  "author": "Muhammad Asif",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*.vercel.app/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
